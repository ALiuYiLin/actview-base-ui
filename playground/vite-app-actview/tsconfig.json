{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@actview/base-ui": ["../../packages/actview/src"],
      "@actview/base-ui/*": ["../../packages/actview/src/*"],
      "@/*": ["../../packages/actview/src/*"],
      "#/*": ["../../packages/actview/*"],
      "@actview/base-ui-utils": ["../../packages/actview-utils/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
