{
  "name": "@actview/base-ui-utils",
  "version": "0.1.0",
  "author": "MUI Team",
  "description": "A collection of ActView utility functions for Base UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mui/base-ui.git",
    "directory": "packages/actview-utils"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('build',{recursive:true,force:true});fs.rmSync('tsconfig.build.tsbuildinfo',{force:true})\" && vite build && tsgo -b tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "cross-env VITEST_ENV=jsdom vitest",
    "typescript": "tsgo -b tsconfig.json"
  },
  "dependencies": {
    "@floating-ui/utils": "^0.2.12",
    "reselect": "^5.2.0"
  },
  "peerDependencies": {
    "@actview/core": "^1.1.0",
    "@actview/jsx": "^1.1.0",
    "actview": "^1.1.1"
  },
  "devDependencies": {
    "@actview/plugin-scoped": "1.0.5",
    "@actview/plugin-vite": "^1.1.1",
    "@actview/testing": "^0.1.1",
    "@testing-library/jest-dom": "6.9.1"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3"
  }
}

