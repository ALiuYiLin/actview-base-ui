{
  "extends": "../../tsconfig.base.json",
  // This config is for emitting declarations (.d.ts) only.
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "stripInternal": true,
    "rootDir": "./src",
    "outDir": "build",
    "jsxImportSource": "@actview/jsx",
    "types": ["node"]
  },
  "include": ["src/**/*.ts*"],
  "exclude": ["src/**/*.spec.ts*", "src/**/*.test.ts*"],
  "references": [{ "path": "../actview-utils/tsconfig.build.json" }]
}
