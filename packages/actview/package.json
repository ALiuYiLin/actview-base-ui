{
  "name": "@actview/base-ui",
  "version": "0.1.1",
  "author": "MUI Team",
  "description": "Base UI is a library of headless ('unstyled') ActView components and low-level hooks. You gain complete control over your app's CSS and accessibility features.",
  "license": "MIT",
  "keywords": [
    "actview",
    "unstyled",
    "base-ui",
    "a11y"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mui/base-ui.git",
    "directory": "packages/actview"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "imports": {
    "#test-utils": "./test/index.ts",
    "#test-utils/rtl": "./test/rtl.ts"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('build',{recursive:true,force:true});fs.rmSync('tsconfig.build.tsbuildinfo',{force:true})\" && vite build && tsgo -b tsconfig.build.json && node scripts/rewrite-dts-aliases.mjs",
    "prepublishOnly": "pnpm build",
    "test": "cross-env VITEST_ENV=jsdom vitest",
    "test:run": "cross-env VITEST_ENV=jsdom vitest run",
    "test:browser": "cross-env VITEST_ENV=browser vitest run",
    "typescript": "tsgo -b tsconfig.json"
  },
  "dependencies": {
    "@actview/base-ui-utils": "workspace:*",
    "@actview/floating-ui": "^0.1.0",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/utils": "^0.2.12",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "@actview/core": "^1.1.0",
    "@actview/jsx": "^1.1.0",
    "actview": "^1.1.1"
  },
  "devDependencies": {
    "@actview/plugin-scoped": "1.0.5",
    "@actview/plugin-vite": "1.1.1",
    "@actview/testing": "0.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/browser-playwright": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3"
  }
}



